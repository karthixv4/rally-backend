DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require"
PORT=3000
NODE_ENV=development
CORS_ORIGINS="https://rally-frontend-nine.vercel.app"
PUBLIC_API_URL="https://your-api-domain"
JWT_SECRET="replace-with-a-long-random-jwt-secret"

# Shared secret used only by the Sarvam connector / voice worker.
SARVAM_WEBHOOK_SECRET="replace-with-a-long-random-webhook-secret"

# Sarvam outbound scheduling integration (server-side only; never expose in the frontend).
SARVAM_SCHEDULING_API_KEY="replace-with-your-sarvam-api-key"
SARVAM_ORG_ID="replace-with-your-sarvam-org-id"
SARVAM_WORKSPACE_ID="replace-with-your-sarvam-workspace-id"
SARVAM_APP_ID="replace-with-your-sarvam-app-id"
SARVAM_APP_VERSION="1"
SARVAM_CONNECTION_ID="replace-with-your-sarvam-connection-id"
SARVAM_CALLER_NUMBER="+910000000000"
SARVAM_MIN_LEAD_TIME_MINUTES="10"

# Automatic waitlist recovery uses Sarvam's immediate outbound API once a
# released event seat is reserved for the next opted-in waitlisted attendee.
# Keep this false until the recovery branch and variables are published in
# Sarvam; then set it to true in Vercel and your local .env.
SARVAM_WAITLIST_RECOVERY_ENABLED="false"
WAITLIST_OFFER_EXPIRY_MINUTES="30"
