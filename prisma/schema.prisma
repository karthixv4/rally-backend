generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AttendeeStatus {
  INVITED
  CONFIRMED
  UNCERTAIN
  DECLINED
  RELEASED
  WAITLISTED
  OFFERED
}

enum FollowUpStatus {
  OPEN
  COMPLETED
}

enum CallOutcome {
  CONFIRMED
  DECLINED
  UNCERTAIN
  WRONG_NUMBER
  VOICEMAIL
  CALL_DISCONNECTED
}

enum SeatRelease {
  YES
  NO
  NOT_ASKED
}

enum CampaignState {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum SeatStatus {
  AVAILABLE
  ASSIGNED
  RELEASED
  OFFERED
}

enum SeatOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum UserRole {
  USER
  ADMIN
}

model Event {
  id                  String     @id @default(cuid())
  userId              String?
  name                String
  startsAt            DateTime?
  venue               String?
  schedule            String?
  parkingInstructions String?
  helpContact         String?
  capacity            Int?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  campaigns           Campaign[]
  attendees           Attendee[]
  followUps           FollowUp[]
  seats               Seat[]
  callEvents          CallEvent[]
  user                User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String
  role         UserRole  @default(USER)
  loginCount   Int       @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  events       Event[]
}

model Campaign {
  id                 String    @id @default(cuid())
  eventId            String
  name               String
  attendanceEnabled  Boolean   @default(true)
  parkingEnabled     Boolean   @default(false)
  foodEnabled        Boolean   @default(false)
  autoCallWaitlist   Boolean   @default(false)
  languages          String[]  @default(["en"])
  tone               String    @default("helpful")
  deadline           DateTime?
  state              CampaignState @default(DRAFT)
  sessionSlotOptions String[]  @default([])
  sarvamCampaignId  String?   @unique
  sarvamCohortUploadedAt DateTime?
  sarvamScheduleStartsAt DateTime?
  sarvamScheduleEndsAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  event              Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  responses          Response[]
  followUps          FollowUp[]
  callEvents         CallEvent[]
  seatOffers         SeatOffer[]
  attendees          Attendee[]
}

model Attendee {
  id             String         @id @default(cuid())
  eventId        String
  campaignId     String?
  name           String
  phone          String?
  optedIn        Boolean        @default(false)
  status         AttendeeStatus @default(INVITED)
  waitlistRank   Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  campaign       Campaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  responses      Response[]
  followUps      FollowUp[]
  callEvents     CallEvent[]
  seat           Seat?
  seatOffers     SeatOffer[]

  @@index([eventId, status])
  @@index([campaignId, status])
}

model Response {
  id                  String       @id @default(cuid())
  campaignId          String
  attendeeId          String
  outcome             CallOutcome
  attendance          Boolean?
  transportMode       String?
  arrivalSlot         String?
  declineReason       String?
  seatRelease         SeatRelease?
  substituteAttendee  String?
  escalationFlag      Boolean      @default(false)
  callSummary         String?
  parking             Boolean?
  foodPreference      String?
  transcript          String?
  dietaryRequirements String?
  accessibilityNeeds  String?
  teamStatus          String?
  createdAt           DateTime     @default(now())
  campaign            Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  attendee            Attendee     @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@index([campaignId, attendeeId])
}

model FollowUp {
  id          String         @id @default(cuid())
  eventId     String
  campaignId  String?
  attendeeId  String?
  summary     String
  private     Boolean        @default(false)
  owner       String?
  type        String         @default("follow_up")
  dueAt       DateTime?
  status      FollowUpStatus @default(OPEN)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  campaign    Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  attendee    Attendee?      @relation(fields: [attendeeId], references: [id], onDelete: SetNull)
}

model CallEvent {
  id          String       @id @default(cuid())
  eventId     String
  campaignId  String
  attendeeId  String
  eventType   String
  outcome     CallOutcome?
  transcript  String?
  details     Json?
  occurredAt  DateTime     @default(now())
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  attendee    Attendee     @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@index([campaignId, occurredAt])
}

model Seat {
  id          String     @id @default(cuid())
  eventId     String
  attendeeId  String?    @unique
  seatNumber  Int
  status      SeatStatus @default(AVAILABLE)
  releasedAt  DateTime?
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee    Attendee?  @relation(fields: [attendeeId], references: [id], onDelete: SetNull)
  offers      SeatOffer[]

  @@unique([eventId, seatNumber])
  @@index([eventId, status])
}

model SeatOffer {
  id          String          @id @default(cuid())
  campaignId  String
  seatId      String
  attendeeId  String
  status      SeatOfferStatus @default(PENDING)
  expiresAt   DateTime
  callRequestedAt DateTime?
  sarvamOutboundId String?
  callFailureReason String?
  createdAt   DateTime        @default(now())
  respondedAt DateTime?
  campaign    Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  seat        Seat            @relation(fields: [seatId], references: [id], onDelete: Cascade)
  attendee    Attendee        @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([campaignId, status, expiresAt])
}
