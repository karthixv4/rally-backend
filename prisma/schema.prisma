generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AttendeeStatus {
  INVITED
  CONFIRMED
  UNCERTAIN
  DECLINED
  RELEASED
  WAITLISTED
  OFFERED
}

enum FollowUpStatus {
  OPEN
  COMPLETED
}

model Event {
  id                  String     @id @default(cuid())
  name                String
  startsAt            DateTime?
  venue               String?
  schedule            String?
  parkingInstructions String?
  helpContact         String?
  capacity            Int?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  campaigns           Campaign[]
  attendees           Attendee[]
  followUps           FollowUp[]
}

model Campaign {
  id                 String    @id @default(cuid())
  eventId            String
  name               String
  attendanceEnabled  Boolean   @default(true)
  parkingEnabled     Boolean   @default(false)
  foodEnabled        Boolean   @default(false)
  languages          String[]  @default(["en"])
  tone               String    @default("helpful")
  deadline           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  event              Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  responses          Response[]
}

model Attendee {
  id             String         @id @default(cuid())
  eventId        String
  name           String
  phone          String?
  optedIn        Boolean        @default(false)
  status         AttendeeStatus @default(INVITED)
  waitlistRank   Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  responses      Response[]
  followUps      FollowUp[]

  @@index([eventId, status])
}

model Response {
  id           String    @id @default(cuid())
  campaignId   String
  attendeeId   String
  attendance   Boolean?
  parking      Boolean?
  foodPreference String?
  transcript   String?
  createdAt    DateTime  @default(now())
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  attendee     Attendee  @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@index([campaignId, attendeeId])
}

model FollowUp {
  id          String         @id @default(cuid())
  eventId     String
  attendeeId  String?
  summary     String
  private     Boolean        @default(false)
  status      FollowUpStatus @default(OPEN)
  createdAt   DateTime       @default(now())
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee    Attendee?      @relation(fields: [attendeeId], references: [id], onDelete: SetNull)
}
